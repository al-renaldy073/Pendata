import numpy as np
from sklearn.linear_model import LinearRegression

# Data
x = np.array([2, 4, 3, 3, 3, 4, 5])
y = np.array([2, 3, 5, 4, 3, 5, 6])

# Mengubah bentuk data x
x1 = x.reshape(-1, 1)

# Membuat model
model = LinearRegression()

# Training model
model.fit(x1, y)

# Mengambil nilai regresi
a = model.intercept_
b = model.coef_[0]

print("=== HASIL SKLEARN ===")
print("Beta 0 =", a)
print("Beta 1 =", b)

print("Persamaan Regresi :")
print("Y =", round(a,4), "+", round(b,4), "X")

# REGRESI LINEAR ANALITIK
# Membuat matriks X
X = np.column_stack((np.ones(len(x)), x))

# Transpose matriks
XT = X.T

# Menghitung X^T X
XTX = np.dot(XT, X)

# Invers matriks
XTX_inv = np.linalg.inv(XTX)

# Menghitung X^T Y
XTY = np.dot(XT, y)

# Menghitung beta
beta = np.dot(XTX_inv, XTY)

print("\n=== HASIL ANALITIK ===")
print("Beta :")
print(beta)

print("Beta 0 =", beta[0])
print("Beta 1 =", beta[1])

print("Persamaan Regresi :")
print("Y =", round(beta[0],4), "+", round(beta[1],4), "X")
